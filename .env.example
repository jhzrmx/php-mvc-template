# local | production (production freezes the DB schema and hides error details)
APP_ENV=local

# true = show error details (class, file, line, stack trace) instead of a generic message.
# If unset, details are shown for APP_ENV=local/development only. NEVER enable in production.
APP_DEBUG=true

# Required: at least 32 characters. Generate one with: php mvc key:generate
JWT_SECRET=

# Turn PHP warnings/notices into exceptions (recommended). Set false to let PHP handle them.
# ERRORS_AS_EXCEPTIONS=true

# Log level: debug | info | warning | error (default: info, or warning in production)
# LOG_LEVEL=info

# Optional: token lifetime in seconds (default 3600 = 1 hour)
JWT_EXPIRES_IN=3600

# Database Setup (RedBeanPHP)
DB_DSN=sqlite:./data/redbean.db
DB_USER=
DB_PASS=

# CORS (optional). Leave empty to disable. Comma-separated origins, or * for any.
# Cookies/credentials need explicit origins (not *) and CORS_ALLOW_CREDENTIALS=true.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# CORS_ALLOW_CREDENTIALS=false
