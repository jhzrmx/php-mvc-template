<?php

// mvc - Main CLI runner script

// Always run from the project root so .env, data/ etc. resolve no matter where the command is typed
chdir(__DIR__);

$command = $argv[1] ?? null;
$args = array_slice($argv, 2);

if (!$command) {
    showHelp();
    exit(1);
}

switch ($command) {
    case 'serve':
        handleServeCommand($args);
        break;
    case 'setup:sqlite':
        handleSetupSqliteCommand($args);
        break;
    case 'help':
    case '--help':
    case '-h':
        showHelp();
        break;
    case 'init':
        handleInitCommand();
        break;
    case 'migrate':
        exit(handleMigrateCommand() ? 0 : 1);
    case 'key:generate':
        handleKeyGenerateCommand($args);
        break;
    case 'user:promote':
        handleUserPromoteCommand($args);
        break;
    default:
        echo "Unknown command: {$command}\n";
        showHelp();
        exit(1);
}

function showHelp() {
    echo <<<HELP
PHP MVC CLI Tool

Usage:
  php mvc <command> [options]

Commands:
  init                Initialize the project (create .env file)
  serve               Start the PHP development server
  setup:sqlite        Set up a SQLite database and run migrations
  migrate             Run pending database migrations (database/migrations)
  key:generate        Generate a random JWT_SECRET in .env (use --force to skip the prompt)
  user:promote NAME   Make a user an admin (use --role=user to demote)
  help                Show this help message

Serve Command Options:
  --port, -p PORT     Port to run the server on (default: 8000)
  --host, -H HOST     Host address (default: localhost)

Setup:Sqlite Command Options:
