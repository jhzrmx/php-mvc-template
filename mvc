<?php

// mvc - Main CLI runner script
use JHz\Database\Database;
use JHz\Http\Route;
use JHz\Support\DotEnv;


// Always run from the project root so .env, data/ etc. resolve no matter where the command is typed
chdir(__DIR__);

$command = $argv[1] ?? null;
$args = array_slice($argv, 2);

if (!$command) {
    showHelp();
    exit(1);
}

switch ($command) {
    case 'serve':
        handleServeCommand($args);
        break;
    case 'setup:sqlite':
        handleSetupSqliteCommand($args);
        break;
    case 'help':
    case '--help':
    case '-h':
        showHelp();
        break;
    case 'init':
        handleInitCommand();
        break;
    case 'migrate':
        exit(handleMigrateCommand() ? 0 : 1);
    case 'key:generate':
        handleKeyGenerateCommand($args);
        break;
    case 'make:controller':
        handleMakeControllerCommand($args);
        break;
    case 'make:model':
        handleMakeModelCommand($args);
        break;
    case 'make:middleware':
        handleMakeMiddlewareCommand($args);
        break;
    case 'make:migration':
        handleMakeMigrationCommand($args);
        break;
    case 'routes':
        handleRoutesCommand();
        break;
    case 'user:promote':
        handleUserPromoteCommand($args);
        break;
    default:
        echo "Unknown command: {$command}\n";
        showHelp();
        exit(1);
}

