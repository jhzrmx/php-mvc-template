}

/**
 * Read user input from stdin
 * 
 * @param string $prompt The prompt to display
 * @return string The trimmed user input
 */
function readStdin($prompt = '') {
    if ($prompt) {
        echo $prompt;
    }
    $handle = fopen("php://stdin", "r");
    $line = trim(fgets($handle));
    fclose($handle);
    return $line;
}

/**
 * Quote a value for .env when it contains characters that would otherwise be misread.
 */
function formatEnvValue($value) {
    if ($value !== '' && !preg_match('/[\s#"\'\\\\$]/', $value)) {
        return $value;
    }
    return '"' . addcslashes($value, '"\\$') . '"';
}

/**
 * Update or set a variable in the .env file
 * 
 * @param string $key The variable name
 * @param string $value The variable value
 * @param string $envFile Path to .env file
 */
function updateEnvVariable($key, $value, $envFile = '.env') {
    $line = $key . '=' . formatEnvValue($value);

    if (!file_exists($envFile)) {
        file_put_contents($envFile, $line . "\n");
        return;
    }

    $content = file_get_contents($envFile);
    $pattern = '/^' . preg_quote($key, '/') . '=.*$/m';

    if (preg_match($pattern, $content)) {
        // Callback form: the value is inserted literally ($1, \0 etc. are NOT interpreted)
        $content = preg_replace_callback($pattern, function () use ($line) {
            return $line;
        }, $content, 1);
    } else {
        $content = rtrim($content) . "\n" . $line . "\n";
    }

    file_put_contents($envFile, $content);
}

/**
 * Create .env file from .env.example
 */
function createEnvFile() {
    if (file_exists('.env')) {
        $response = readStdin(".env file already exists. Recreate? (y/n): ");
        if ($response !== 'y') {
            echo "Skipping .env file creation.\n";
            return false;
        }
    }
    
    echo "Creating .env file from .env.example...\n";
    if (file_exists('.env.example')) {
        copy('.env.example', '.env');
        echo ".env file created successfully!\n";
        return true;
    }
    
    echo "Warning: .env.example not found. Creating empty .env file.\n";
    touch('.env');
    return true;
}

/**
 * Setup SQLite database file
 * 
 * An existing database is never deleted without an explicit "y" from the user.
 * 
 * @param string $dbname Database name
 * @param bool $silent Non-interactive: keep an existing database instead of asking
 * @return bool True if the database file is ready to use
 */
function setupSqliteDatabase($dbname, $silent = false) {
    $dbPath = __DIR__ . '/data/' . $dbname;

    if (!is_dir(__DIR__ . '/data')) {
        mkdir(__DIR__ . '/data', 0755, true);
        if (!$silent) {
            echo "Created data directory\n";
        }
    }

    if (file_exists($dbPath)) {
        if ($silent) {
            echo "Database already exists at {$dbPath}, keeping it.\n";
            return true;
        }
        $response = readStdin("Database file already exists. Overwrite (this deletes all its data)? (y/n): ");
        if ($response !== 'y') {
            echo "Skipping database setup.\n";
            return false;
        }
        unlink($dbPath);
        echo "Existing database removed.\n";
    }

    touch($dbPath);
    echo "✓ Database file created at {$dbPath}\n";
    return true;
}

/**
 * Get option value from command arguments
 * Supports formats: --long=value, --long value, -s value
 * 
 * @param array $args The command arguments
 * @param string $longName The long option name
 * @param string|null $shortName The short option name
 * @return string|null The option value or null if not found
 */
function getOptionValue($args, $longName, $shortName = null) {
    // Handle --long=value format
    $longPattern = "--{$longName}=";
    foreach ($args as $arg) {
        if (strpos($arg, $longPattern) === 0) {
            return substr($arg, strlen($longPattern));
        }
    }
    
    // Handle --long value format
    for ($i = 0; $i < count($args); $i++) {
        if ($args[$i] === "--{$longName}" && isset($args[$i + 1])) {
            return $args[$i + 1];
        }
    }
    
    // Handle -s value format (short option)
    if ($shortName) {
        for ($i = 0; $i < count($args); $i++) {
            if ($args[$i] === "-{$shortName}" && isset($args[$i + 1])) {
                return $args[$i + 1];
            }
        }
    }
    
    return null;
}

function handleServeCommand($args) {
    $port = getOptionValue($args, 'port', 'p') ?? '8000';
    $host = getOptionValue($args, 'host', 'H') ?? 'localhost';
    
    echo "Starting PHP development server...\n";
    echo "Server running at http://{$host}:{$port}/\n";
    echo "Document root: " . __DIR__ . "/public\n";
    echo "Press Ctrl+C to stop.\n\n";
    
    // Build the command
    // Serve ONLY the public/ directory so .env, data/, storage/ etc. can never be downloaded
    $cmd = sprintf(
        '%s -S %s -t %s',
        escapeshellarg(PHP_BINARY),
        escapeshellarg($host . ':' . $port),
        escapeshellarg(__DIR__ . '/public')
    );
    
    passthru($cmd);
}

function handleSetupSqliteCommand($args) {
    $dbname = getOptionValue($args, 'dbname', 'd') ?? 'redbean.db';
    
    // Ensure .db extension if not present
    if (pathinfo($dbname, PATHINFO_EXTENSION) !== 'db') {
        $dbname .= '.db';
    }
    
    if (setupSqliteDatabase($dbname, false)) {
        // Update .env with the new DSN
        updateEnvVariable('DB_DSN', "sqlite:./data/{$dbname}");
        echo "✓ Updated .env file with SQLite DSN\n";
        if (!handleMigrateCommand()) {
            exit(1);
        }
    }
}

function handleInitCommand() {
    echo "Initializing project...\n";
    
    createEnvFile();
    ensureJwtSecret();
    
    $useSqlite = readStdin("Use SQLite? (y/n): ");
    
    if ($useSqlite === 'y') {
        $dbname = readStdin("Enter SQLite database name (default: redbean.db): ");
        if (empty($dbname)) {
            $dbname = 'redbean.db';
        }
        if (pathinfo($dbname, PATHINFO_EXTENSION) !== 'db') {
            $dbname .= '.db';
        }
        
        // Create the database (an existing one is kept), point .env at it, and create the tables
        setupSqliteDatabase($dbname, true);
        updateEnvVariable('DB_DSN', "sqlite:./data/{$dbname}");
        echo ".env file updated with SQLite DSN\n";
        if (!handleMigrateCommand()) {
            exit(1);
        }
    } else {
        echo "Using MySQL as default database.\n";
        updateEnvVariable('DB_DSN', "mysql:host=127.0.0.1;dbname=mvc_db");
        echo "Next: create the database, set DB_USER / DB_PASS in .env, then run: php mvc migrate\n";
    }
}

/**
 * Read a raw value from the .env file (or null if missing).
 */
function readEnvValue($key, $envFile = '.env') {
    if (!file_exists($envFile)) return null;
    $content = file_get_contents($envFile);
    if (!preg_match('/^' . preg_quote($key, '/') . '=(.*)$/m', $content, $m)) return null;
    return trim(trim($m[1]), "\"'");
}

function jwtSecretIsValid($secret) {
    return is_string($secret)
        && strlen($secret) >= 32
        && $secret !== 'your-super-secret-key-at-least-32-chars-long';
}

/**
 * Generate a JWT secret only if the current one is missing, too short, or the old example value.
 */
function ensureJwtSecret() {
    if (jwtSecretIsValid(readEnvValue('JWT_SECRET'))) {
        return;
    }
    updateEnvVariable('JWT_SECRET', bin2hex(random_bytes(32)));
    echo "✓ Generated a random JWT_SECRET in .env\n";
}

function handleKeyGenerateCommand($args) {
    if (!file_exists('.env')) {
        echo "No .env file found. Run: php mvc init\n";
        exit(1);
    }
    $force = in_array('--force', $args, true);
    if (!$force && jwtSecretIsValid(readEnvValue('JWT_SECRET'))) {
        $response = readStdin("A valid JWT_SECRET already exists. Replacing it signs out every user. Continue? (y/n): ");
        if ($response !== 'y') {
            echo "Cancelled.\n";
            return;
        }
    }
    updateEnvVariable('JWT_SECRET', bin2hex(random_bytes(32)));
    echo "✓ New JWT_SECRET written to .env\n";
}

/**
 * Boot just enough of the app (env + database + models) for CLI commands.
 *
 * @param bool $freezeInProduction Pass false for commands that change the schema (migrate).
 */
function bootApp($freezeInProduction = true) {
    if (!defined('BASE_PATH')) {
        define('BASE_PATH', __DIR__);
    }
    chdir(BASE_PATH);
    require_once BASE_PATH . '/libs/index.php';
    DotEnv::loadFromFile(BASE_PATH . '/.env');
    Database::connect($freezeInProduction);
    require_once BASE_PATH . '/models/User.php';
}

/**
 * Run every migration in database/migrations that hasn't run yet.
 * Runs with the schema unfrozen, so it also works when APP_ENV=production.
 */
function handleMigrateCommand() {
    try {
        bootApp(false);

        if (!in_array('migration', R::inspect(), true)) {
            $seed = R::dispense('migration');
            $seed->name = '__init__';
            $seed->executed_at = date('Y-m-d H:i:s');
            R::store($seed);
            R::trash($seed);
        }

        $done = R::getCol('SELECT name FROM migration');
        $files = glob(__DIR__ . '/database/migrations/*.php') ?: [];
        sort($files);

        $ran = 0;
        foreach ($files as $file) {
            $name = basename($file, '.php');
            if (in_array($name, $done, true)) {
                continue;
            }
            echo "Migrating: {$name}\n";
            $up = require $file;
            if (!is_callable($up)) {
                throw new Exception("Migration {$name} must return a function.");
            }
            $up();

            $row = R::dispense('migration');
            $row->name = $name;
            $row->executed_at = date('Y-m-d H:i:s');
            R::store($row);
            $ran++;
        }

        echo $ran > 0 ? "✓ Ran {$ran} migration(s)\n" : "Nothing to migrate.\n";
        return true;
    } catch (Throwable $e) {
        echo "Migration failed: " . $e->getMessage() . "\n";
        return false;
    }
}

function handleUserPromoteCommand($args) {
    $username = null;
    foreach ($args as $arg) {
        if (strpos($arg, '-') !== 0) {
            $username = $arg;
            break;
        }
    }
    $role = getOptionValue($args, 'role') ?? 'admin';

    if (!$username) {
        echo "Usage: php mvc user:promote USERNAME [--role=admin|user]\n";
        exit(1);
    }

    try {
        bootApp();
        $bean = User::findByUsername($username);
        if (!$bean) {
            echo "User not found: {$username}\n";
            exit(1);
        }
        User::setRole($bean, $role);
        echo "✓ {$username} is now '{$role}' (their existing sessions were signed out)\n";
    } catch (Throwable $e) {
        echo "Error: " . $e->getMessage() . "\n";
        exit(1);
    }
}
