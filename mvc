function handleMakeMigrationCommand($args) {
    $name = firstPositional($args);
    $name = $name ? strtolower(preg_replace('/[\s-]+/', '_', $name)) : null;
    if (!$name || !preg_match('/^[a-z][a-z0-9_]*$/', $name)) {
        echo "Usage: php mvc make:migration create_post_table\n";
        exit(1);
    }
    $body = <<<'PHP'
<?php

/**
 * Run with: php mvc migrate
 *
 * RedBean builds a table from a "seed" bean: the values you give decide the column types.
 * Store the seed and delete it again so only the columns remain:
 *
 *   $seed = R::dispense('post');
 *   $seed->title = 'seed';
 *   $seed->views = 2000000000;   // large number => a real INT column
 *   $seed->created_at = date('Y-m-d H:i:s');
 *   R::store($seed);
 *   R::trash($seed);
 *
 * Raw SQL works too: R::exec('CREATE INDEX ...');
 */
return function () {
    // your schema changes here
};

PHP;
    makeFile('database/migrations/' . date('Y_m_d_His') . "_{$name}.php", $body);
}

function handleRoutesCommand() {
    try {
        bootApp(true, false);
        Route::loadRoutes();
        $rows = Route::routes();
    } catch (Throwable $e) {
        echo "Error: " . $e->getMessage() . "\n";
        exit(1);
    }

    if (!$rows) {
        echo "No routes registered.\n";
        return;
    }

    $headers = ['METHOD' => 'method', 'URI' => 'uri', 'NAME' => 'name', 'ACTION' => 'action', 'MIDDLEWARE' => 'middleware'];
    $widths = [];
    foreach ($headers as $title => $key) {
        $widths[$key] = strlen($title);
        foreach ($rows as $row) {
            $widths[$key] = max($widths[$key], strlen($row[$key]));
        }
    }
    $line = function ($cells) use ($headers, $widths) {
        $out = [];
        foreach ($headers as $title => $key) {
            $out[] = str_pad($cells[$key], $widths[$key]);
        }
        return '  ' . rtrim(implode('  ', $out)) . "\n";
    };
    echo $line(array_combine(array_values($headers), array_keys($headers)));
    foreach ($rows as $row) {
        echo $line($row);
    }
}
