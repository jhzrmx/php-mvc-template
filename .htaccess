# Only needed if your server's document root is the project root and
# cannot be pointed at /public. Everything is forwarded into /public,
# so app code, .env, data/ and storage/ are never served directly.
# Best practice: set the document root to /public and ignore this file.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^$ public/ [L]
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
